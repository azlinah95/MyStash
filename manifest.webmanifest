{
  "id": "./",
  "name": "Reading Room Archive",
  "short_name": "Reading Room",
  "description": "A private magical library for saved recipes, routines, workouts, and inspiration.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#f5f0e8",
  "theme_color": "#171614",
  "icons": [
    {
      "src": "./icons/reading-room-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "./icons/reading-room-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/reading-room-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
